# Copy to `.env` for local overrides, or set in your host's dashboard for prod.

# Base URL for all /media assets (videos, posters, filmstrips, testimonials).
# Leave EMPTY for local dev — Vite serves them from /public/media.
# In production, set this to your Cloudflare R2 public URL (no trailing slash):
#   VITE_MEDIA_BASE=https://media.cizaro.com
# or the r2.dev URL R2 gives you:
#   VITE_MEDIA_BASE=https://pub-xxxxxxxx.r2.dev
VITE_MEDIA_BASE=
